{
  "name": "trust-kit",
  "private": true,
  "version": "0.1.0",
  "description": "Agentic Kit for eve (Vercel) builders: inspect, stamp, and ship agents you can defend.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://agentic-kit.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielalbinsson/trust-kit.git"
  },
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "dev": "vite",
    "generate:llms": "tsx scripts/generate-llms.ts",
    "generate:discoverability": "tsx scripts/generate-discoverability.ts",
    "validate:jsonld": "tsx scripts/validate-jsonld.ts",
    "check:passports": "tsx scripts/check-passports.ts",
    "check:sync": "pnpm generate:llms && pnpm generate:discoverability && git diff --exit-code public/llms.txt public/llms/ public/robots.txt public/sitemap.xml public/route-lastmod.json public/llms-full.txt public/ai.txt public/.well-known/",
    "prebuild": "pnpm generate:llms && pnpm generate:discoverability",
    "build": "pnpm check:passports && tsc -b && vite build && tsx scripts/prerender.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "mcp-handler": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.3",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
