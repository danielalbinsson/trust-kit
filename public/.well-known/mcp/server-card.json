{
  "$schema": "https://modelcontextprotocol.io/schemas/server-card/v1.0",
  "version": "1.0",
  "protocolVersion": "2025-03-26",
  "serverInfo": {
    "name": "agentic-kit",
    "version": "0.1.0",
    "description": "Agentic Kit docs, policy packs, and pointers to Aletheia for Eve agent trust.",
    "homepage": "https://agentic-kit.dev/",
    "documentationUrl": "https://agentic-kit.dev/docs"
  },
  "transport": {
    "type": "streamable-http",
    "url": "https://agentic-kit.dev/api/mcp"
  },
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": true
  },
  "configSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false,
    "description": "No configuration required. The server reads public docs and policy packs at runtime."
  },
  "tools": [
    {
      "name": "list_docs",
      "description": "List Agentic Kit doc ids. Prefer resources/list for MCP-native discovery.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_doc",
      "description": "Retrieve one Agentic Kit doc spec. Prefer resource agentic-kit://docs/{id}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Doc id slug",
            "enum": [
              "honesty-contract",
              "cli",
              "golden-path",
              "ci",
              "kit-certified",
              "disclaimer",
              "roadmap"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_policy_packs",
      "description": "List published policy pack ids.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_policy_pack",
      "description": "Retrieve one policy pack JSON. Prefer resource agentic-kit://policy-packs/{id}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "support-bot",
              "payments-high",
              "design-tools"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_full_library",
      "description": "Retrieve llms-full.txt. Prefer resource agentic-kit://library/full.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "resources": [
    {
      "uri": "agentic-kit://library/full",
      "name": "library-full",
      "title": "Full Agentic Kit corpus",
      "description": "Complete docs corpus (llms-full.txt).",
      "mimeType": "text/plain"
    }
  ],
  "resourceTemplates": [
    {
      "name": "doc-spec",
      "uriTemplate": "agentic-kit://docs/{id}",
      "title": "Agentic Kit doc specification",
      "description": "Per-doc spec from public/llms/docs/{id}.txt."
    },
    {
      "name": "policy-pack",
      "uriTemplate": "agentic-kit://policy-packs/{id}",
      "title": "Policy pack JSON",
      "description": "Blast-radius policy pack from public/policy-packs/{id}.json."
    }
  ],
  "prompts": [
    {
      "name": "inspect-eve-agent",
      "description": "Inspect an Eve agent with Aletheia honesty rules. Do not invent trust claims.",
      "arguments": [
        {
          "name": "agentPath",
          "description": "Path or repo URL of the Eve agent workspace",
          "required": true
        },
        {
          "name": "goal",
          "description": "What to verify (portrait, authority diff, Kit Certified checklist)",
          "required": false
        }
      ]
    }
  ]
}